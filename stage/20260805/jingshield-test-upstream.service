[Unit]
Description=JingShield isolated test upstream
After=network.target

[Service]
Type=simple
User=jingshield
Group=jingshield
ExecStart=/usr/bin/python3 -m http.server 19000 --bind 127.0.0.1 --directory /opt/jingshield/upstream
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
