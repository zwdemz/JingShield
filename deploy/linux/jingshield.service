[Unit]
Description=JieYun JingShield WAF
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=jingshield
Group=jingshield
WorkingDirectory=/opt/jingshield
EnvironmentFile=/etc/jingshield/jingshield.env
ExecStart=/opt/jingshield/bin/jingshield -c /etc/jingshield/config.yaml
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/jingshield /opt/jingshield/data
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
